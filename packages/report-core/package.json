{
  "name": "@bw-central/report-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/resizeImage.d.ts",
      "import": "./dist/browser/resizeImage.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "@bw-central/bcf-core": "workspace:*",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
